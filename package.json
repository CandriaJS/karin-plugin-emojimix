{
  "name": "@candriajs/karin-plugin-emojimix",
  "version": "1.1.6",
  "description": "一个Karin版的emoji合成插件",
  "keywords": [
    "karin-plugin",
    "karin-plugin-emojimix"
  ],
  "homepage": "https://github.com/CandriaJS/karin-plugin-emojimix",
  "bugs": {
    "url": "https://github.com/CandriaJS/karin-plugin-emojimix/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CandriaJS/karin-plugin-emojimix.git"
  },
  "license": "GNU General Public License v3.0",
  "author": "CandriaJS",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "config/",
    "lib/",
    "resources/",
    "LICENSE",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "app": "node --import tsx src/app.ts",
    "build": "tsc --noEmit && tsdown",
    "dev": "cross-env EBV_FILE=\"development.env\" node --import tsx src/app.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "watch": "cross-env EBV_FILE=\"development.env\" tsx watch --include \"src/**/*.ts\" src/app.ts"
  },
  "dependencies": {
    "@puniyu/component": "^0.6.0",
    "@puniyu/lumio": "^0.1.2",
    "emoji-regex": "^10.4.0",
    "markdown-it": "^14.1.0",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.3",
    "cross-env": "^7.0.3",
    "node-karin": "^1.10.2",
    "oxlint": "^1.32.0",
    "oxfmt": "^0.48.0",
    "tsc-alias": "1.8.13",
    "tsdown": "^0.17.2",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3"
  },
  "karin": {
    "main": "src/index.ts",
    "web": "./lib/web.config.js",
    "ts-web": "./src/web.config.ts",
    "apps": [
      "lib/apps"
    ],
    "ts-apps": [
      "src/apps"
    ],
    "static": [
      "resources"
    ],
    "files": [
      "config",
      "data",
      "resources"
    ],
    "engines": {
      "karin": ">=1.10.1"
    }
  },
  "packageManager": "pnpm@10.25.0"
}
